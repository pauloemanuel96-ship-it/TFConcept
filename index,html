<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TF Concept — Brand Suite</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --areia:#EDE4D8;
    --areia-soft:#F6F0E7;
    --cream:#FFFDF9;
    --terracota:#C9694E;
    --terracota-deep:#96432E;
    --terracota-tint:#E8B8A8;
    --rosa:#C6567A;
    --rosa-deep:#8F3552;
    --rosa-tint:#EAB9CB;
    --oliva:#3F4A3C;
    --oliva-deep:#2E362B;
    --ink:#2B2B28;
    --ink-soft:rgba(43,43,40,0.62);
    --line:rgba(43,43,40,0.14);
    --line-on-dark:rgba(237,228,216,0.24);
    --shadow: 0 30px 60px -25px rgba(43,43,40,0.35);
    --ease: cubic-bezier(.22,.68,.14,1);
  }

  *,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }

  html{ scroll-behavior:smooth; }

  body{
    font-family:'Jost', sans-serif;
    background:var(--areia);
    color:var(--ink);
    overflow-x:hidden;
  }

  ::selection{ background:var(--terracota); color:var(--cream); }

  h1,h2,h3,.serif{ font-family:'Fraunces', serif; font-weight:500; letter-spacing:-0.01em; }

  .eyebrow{
    font-family:'Jost', sans-serif;
    font-weight:600;
    font-size:12.5px;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--terracota-deep);
    display:flex;
    align-items:center;
    gap:10px;
  }
  .eyebrow::before{
    content:"";
    width:26px;
    height:1px;
    background:var(--terracota-deep);
    display:inline-block;
  }
  .eyebrow.on-dark{ color:var(--terracota-tint); }
  .eyebrow.on-dark::before{ background:var(--terracota-tint); }

  /* ---------- stitch motif : the signature element ---------- */
  .stitch{
    height:10px;
    background-image: repeating-linear-gradient(
      90deg,
      currentColor 0, currentColor 7px,
      transparent 7px, transparent 15px
    );
    background-position: center;
    background-size: 100% 2px;
    background-repeat: repeat-x;
    color:var(--terracota);
    opacity:.55;
  }
  .stitch.thin{ height:6px; }
  .stitch.dark{ color:var(--oliva); }
  .stitch.on-dark{ color:var(--terracota-tint); opacity:.5; }

  .seal{
    width:96px; height:96px;
    border-radius:50%;
    border:1.5px solid currentColor;
    display:flex; align-items:center; justify-content:center;
    position:relative;
    flex-shrink:0;
  }
  .seal::before{
    content:"";
    position:absolute; inset:7px;
    border-radius:50%;
    border:1px dashed currentColor;
    opacity:.55;
  }
  .seal span{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-size:15px;
    letter-spacing:0.02em;
  }

  /* ---------- scaffolding ---------- */
  .rail{
    position:fixed;
    right:26px; top:50%; transform:translateY(-50%);
    z-index:60;
    display:flex; flex-direction:column; gap:13px;
    align-items:flex-end;
  }
  .rail button{
    all:unset;
    cursor:pointer;
    display:flex; align-items:center; gap:10px;
    color:var(--ink);
  }
  .rail button .dot{
    width:7px; height:7px; border-radius:50%;
    background:rgba(43,43,40,0.28);
    transition: all .35s var(--ease);
  }
  .rail button .lbl{
    font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
    opacity:0; transform:translateX(6px);
    transition: all .35s var(--ease);
    white-space:nowrap;
    font-weight:600;
  }
  .rail button:hover .lbl{ opacity:.7; transform:translateX(0); }
  .rail button:focus-visible .dot{ outline:2px solid var(--terracota-deep); outline-offset:3px; }
  .rail button.active .dot{ background:var(--terracota-deep); transform:scale(1.5); }
  .rail button.on-dark .dot{ background:rgba(237,228,216,0.4); }
  .rail button.on-dark.active .dot{ background:var(--terracota-tint); }
  @media (max-width: 860px){ .rail{ display:none; } }

  .brandmark{
    position:fixed; top:26px; left:26px; z-index:60;
    font-family:'Fraunces', serif; font-weight:600; font-size:14px;
    letter-spacing:0.03em;
    color:var(--ink);
    mix-blend-mode:difference;
    filter:invert(1) grayscale(1) brightness(1.6);
  }
  .counter{
    position:fixed; bottom:26px; left:26px; z-index:60;
    font-size:11px; letter-spacing:.12em;
    color:var(--ink);
    mix-blend-mode:difference;
    filter:invert(1) grayscale(1) brightness(1.6);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width:640px){ .brandmark,.counter{ display:none; } }

  section{
    min-height:100vh;
    width:100%;
    position:relative;
    padding: 110px 8vw 90px;
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  section.dark{ background:var(--oliva); color:var(--areia-soft); }
  section.dark h1, section.dark h2, section.dark h3{ color:var(--cream); }
  section.tinted{ background:var(--areia-soft); }
  section.terra{ background:var(--terracota); color:var(--cream); }

  .reveal{ opacity:0; transform:translateY(26px); transition: opacity .9s var(--ease), transform .9s var(--ease); }
  .reveal.in{ opacity:1; transform:translateY(0); }
  .reveal.d1{ transition-delay:.08s; }
  .reveal.d2{ transition-delay:.16s; }
  .reveal.d3{ transition-delay:.24s; }
  .reveal.d4{ transition-delay:.32s; }
  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    .reveal{ opacity:1; transform:none; transition:none; }
  }

  .kicker-num{
    font-family:'Fraunces', serif;
    font-weight:300;
    font-style:italic;
    color:var(--terracota);
    font-size:15px;
  }
  section.dark .kicker-num{ color:var(--terracota-tint); }

  p{ line-height:1.65; color:var(--ink-soft); font-size:16.5px; font-weight:300; }
  section.dark p{ color:rgba(237,228,216,0.78); }
  section.terra p{ color:rgba(255,253,249,0.88); }

  .max{ max-width:1180px; margin:0 auto; width:100%; }

  /* ============ 00 COVER ============ */
  #s0{
    background:
      radial-gradient(1100px 700px at 82% -10%, rgba(201,123,99,0.28), transparent 60%),
      radial-gradient(900px 600px at -10% 110%, rgba(63,74,60,0.18), transparent 55%),
      var(--areia);
    padding-top:0; padding-bottom:0;
  }
  .cover-wrap{ max-width:1180px; margin:0 auto; width:100%; }
  .cover-top{
    display:flex; justify-content:space-between; align-items:flex-start;
    margin-bottom:8vh;
  }
  .cover-top .tag{
    text-align:right; font-size:12px; letter-spacing:.1em; color:var(--ink-soft);
    line-height:1.6;
  }
  .cover-name{
    font-size: clamp(64px, 12vw, 168px);
    line-height:0.86;
    font-weight:500;
    letter-spacing:-0.02em;
  }
  .cover-name em{ font-style:italic; font-weight:400; color:var(--terracota-deep); }
  .cover-sub{
    margin-top:26px;
    max-width:560px;
    font-size:19px;
    font-weight:300;
    color:var(--ink-soft);
    line-height:1.6;
  }
  .cover-bottom{
    margin-top:9vh;
    display:flex; justify-content:space-between; align-items:flex-end;
    flex-wrap:wrap; gap:26px;
    border-top:1px solid var(--line);
    padding-top:26px;
  }
  .swatch-row{ display:flex; gap:0; }
  .swatch-row div{ width:46px; height:46px; }
  .cover-tagline{
    font-family:'Fraunces', serif; font-style:italic; font-weight:400;
    font-size:22px; color:var(--oliva);
  }

  /* ============ 01 THESIS ============ */
  .thesis-quote{
    font-size: clamp(30px, 5.4vw, 62px);
    line-height:1.12;
    font-weight:400;
    max-width:960px;
  }
  .thesis-quote em{ color:var(--terracota-deep); font-style:italic; font-weight:500; }
  .thesis-body{ max-width:620px; margin-top:34px; display:flex; flex-direction:column; gap:16px; }
  .thesis-body p{ font-size:17.5px; }

  /* ============ pillars / mission / vision ============ */
  .pillar-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:1px;
    background:var(--line);
    border:1px solid var(--line);
    margin-top:48px;
  }
  .pillar-card{ background:var(--areia-soft); padding:34px 30px; }
  .pillar-card .n{ font-family:'Fraunces',serif; font-style:italic; color:var(--terracota-deep); font-size:14px; }
  .pillar-card h3{ font-size:21px; margin:14px 0 10px; }
  .pillar-card p{ font-size:14.5px; }
  @media (max-width:860px){ .pillar-grid{ grid-template-columns:1fr; } }

  .values-strip{
    display:flex; flex-wrap:wrap; gap:12px; margin-top:22px;
  }
  .values-strip span{
    border:1px solid var(--line-on-dark);
    padding:9px 18px;
    border-radius:100px;
    font-size:13px;
    letter-spacing:.03em;
  }

  /* ============ personas ============ */
  .persona-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:28px;
    margin-top:44px;
  }
  .persona-card{
    background:var(--cream);
    border:1px solid var(--line);
    padding:30px 26px;
    position:relative;
  }
  .persona-card .age{
    font-family:'Fraunces',serif; font-size:52px; font-style:italic; font-weight:400;
    color:var(--rosa-tint);
    line-height:1;
  }
  .persona-card h3{ font-size:19px; margin-top:8px; }
  .persona-card .role{ font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); margin:4px 0 16px; }
  .persona-card .quote{ font-family:'Fraunces',serif; font-style:italic; font-size:15.5px; color:var(--oliva); line-height:1.5; margin-bottom:16px; }
  .persona-card .need{ font-size:13.5px; border-top:1px solid var(--line); padding-top:14px; }
  .persona-card .need b{ display:block; color:var(--ink); font-weight:600; font-size:11px; letter-spacing:.08em; text-transform:uppercase; margin-bottom:4px; }
  @media (max-width:860px){ .persona-grid{ grid-template-columns:1fr; } }

  /* ============ positioning quadrant ============ */
  .quad-wrap{
    display:grid; grid-template-columns: 1fr 1.3fr; gap:60px; align-items:center; margin-top:40px;
  }
  .quad{
    aspect-ratio:1/1;
    position:relative;
    border:1px solid var(--line);
  }
  .quad::before,.quad::after{
    content:""; position:absolute; background:var(--line);
  }
  .quad::before{ left:50%; top:0; bottom:0; width:1px; }
  .quad::after{ top:50%; left:0; right:0; height:1px; }
  .quad-axis{ position:absolute; font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-soft); }
  .qa-top{ top:-24px; left:50%; transform:translateX(-50%); }
  .qa-bottom{ bottom:-24px; left:50%; transform:translateX(-50%); }
  .qa-left{ left:-8px; top:50%; transform:translateY(-50%) rotate(-90deg) translateX(50%); transform-origin:left center; }
  .qa-right{ right:-8px; top:50%; transform:translateY(-50%) rotate(90deg) translateX(-50%); transform-origin:right center; }
  .qdot{
    position:absolute;
    display:flex; flex-direction:column; align-items:center; gap:6px;
    transform:translate(-50%,-50%);
    font-size:11px; text-align:center; white-space:nowrap;
  }
  .qdot i{ width:10px; height:10px; border-radius:50%; background:var(--oliva); display:block; }
  .qdot.hero i{ width:16px; height:16px; background:var(--terracota-deep); box-shadow:0 0 0 5px rgba(201,123,99,0.18); }
  .qdot.hero{ font-weight:600; }
  .quad-legend{ display:flex; flex-direction:column; gap:18px; }
  .quad-legend .item{ display:flex; gap:14px; align-items:flex-start; border-bottom:1px solid var(--line); padding-bottom:14px; }
  .quad-legend .item i{ width:9px; height:9px; border-radius:50%; background:var(--oliva); margin-top:6px; flex-shrink:0; }
  .quad-legend .item.hero i{ background:var(--terracota-deep); }
  .quad-legend b{ display:block; font-size:14.5px; font-weight:600; }
  .quad-legend span{ font-size:13px; color:var(--ink-soft); }
  @media (max-width:860px){ .quad-wrap{ grid-template-columns:1fr; } }

  /* ============ identity: color + type ============ */
  .id-grid{ display:grid; grid-template-columns:1.1fr 1fr; gap:70px; margin-top:44px; align-items:start; }
  .swatch-list{ display:flex; flex-direction:column; }
  .swatch-item{
    display:flex; align-items:center; gap:22px;
    padding:20px 0; border-bottom:1px solid var(--line);
  }
  .swatch-item .chip{ width:64px; height:64px; flex-shrink:0; border:1px solid var(--line); }
  .swatch-item .meta b{ display:block; font-size:15.5px; font-weight:600; }
  .swatch-item .meta span{ font-size:12.5px; color:var(--ink-soft); letter-spacing:.03em; font-variant-numeric: tabular-nums;}
  .swatch-item .meta em{ display:block; font-size:12.5px; font-style:normal; color:var(--ink-soft); margin-top:3px; max-width:340px; }

  .type-sample{ border:1px solid var(--line); padding:30px; background:var(--cream); margin-bottom:22px; }
  .type-sample .tlabel{ font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--terracota-deep); margin-bottom:14px; font-weight:600; }
  .type-sample .tbig{ font-family:'Fraunces',serif; font-size:40px; font-weight:500; line-height:1.05; }
  .type-sample.sans .tbig{ font-family:'Jost',sans-serif; font-size:15px; letter-spacing:.14em; text-transform:uppercase; font-weight:500; }
  .type-sample .tnote{ margin-top:14px; font-size:12px; color:var(--ink-soft); }

  /* ============ voice do/dont ============ */
  .voice-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:22px; margin-top:44px; }
  .voice-card{ background:var(--oliva-deep); border:1px solid var(--line-on-dark); padding:26px; }
  .voice-card h3{ font-size:18px; margin-bottom:14px; color:var(--terracota-tint); font-style:italic; font-family:'Fraunces',serif; font-weight:500;}
  .voice-row{ display:flex; gap:10px; align-items:flex-start; margin-bottom:10px; font-size:13.5px; }
  .voice-row .tag{ font-size:10px; letter-spacing:.08em; text-transform:uppercase; font-weight:700; padding:2px 8px; border-radius:3px; flex-shrink:0; margin-top:2px; }
  .voice-row.do .tag{ background:rgba(201,123,99,0.25); color:var(--terracota-tint); }
  .voice-row.dont .tag{ background:rgba(237,228,216,0.1); color:rgba(237,228,216,0.5); }
  .voice-row span:last-child{ color:rgba(237,228,216,0.82); line-height:1.5; }
  @media (max-width:860px){ .voice-grid{ grid-template-columns:1fr; } }

  /* ============ manifesto ============ */
  #manifesto{
    background:var(--oliva-deep);
    color:var(--cream);
    align-items:center;
  }
  .manifesto-wrap{ max-width:820px; margin:0 auto; text-align:left; position:relative; }
  .manifesto-mark{ font-family:'Fraunces',serif; font-size:120px; font-style:italic; color:var(--terracota); opacity:.4; line-height:0.6; }
  .manifesto-text{
    font-family:'Fraunces',serif;
    font-size:clamp(24px,3.6vw,38px);
    font-weight:400; font-style:italic;
    line-height:1.42;
    color:var(--areia-soft);
  }
  .manifesto-text b{ font-weight:600; font-style:normal; color:var(--terracota-tint); }
  .manifesto-sign{ margin-top:38px; font-size:13px; letter-spacing:.1em; text-transform:uppercase; color:rgba(237,228,216,0.5); }

  /* ============ messaging hierarchy ============ */
  .msg-level{ border-top:1px solid var(--line); padding:26px 0; }
  .msg-level .lv{ font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--terracota-deep); font-weight:600; margin-bottom:8px; }
  .msg-level h2{ font-size:clamp(24px,3vw,38px); font-weight:500; max-width:820px; }
  .msg-level p.support{ font-size:16.5px; max-width:680px; margin-top:8px; color:var(--ink-soft); }
  .msg-cards{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:18px; }
  .msg-card{ background:var(--cream); border:1px solid var(--line); padding:22px; }
  .msg-card b{ display:block; font-family:'Fraunces',serif; font-size:17px; font-weight:600; margin-bottom:8px; color:var(--rosa-deep); }
  .msg-card p{ font-size:13.5px; }
  @media (max-width:860px){ .msg-cards{ grid-template-columns:1fr; } }

  /* ============ naming gauge ============ */
  .naming-wrap{ display:grid; grid-template-columns:auto 1fr; gap:70px; align-items:center; margin-top:40px; }
  .gauge{ width:200px; height:200px; border-radius:50%; position:relative; flex-shrink:0;
    background: conic-gradient(var(--terracota-deep) 0turn 0.75turn, var(--line) 0.75turn 1turn); }
  .gauge::before{ content:""; position:absolute; inset:16px; border-radius:50%; background:var(--areia-soft); }
  .gauge .val{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:'Fraunces',serif; }
  .gauge .val b{ font-size:44px; font-weight:500; }
  .gauge .val span{ font-size:11px; font-family:'Jost',sans-serif; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-soft); }
  .naming-points{ display:flex; flex-direction:column; gap:0; }
  .naming-points .row{ display:flex; gap:16px; padding:12px 0; border-bottom:1px solid var(--line); font-size:14px; }
  .naming-points .row b{ min-width:190px; flex-shrink:0; font-weight:600; }
  .naming-points .row span{ color:var(--ink-soft); }
  @media (max-width:860px){ .naming-wrap{ grid-template-columns:1fr; } .naming-points .row{ flex-direction:column; gap:4px; } }

  /* ============ packaging / mala vip ============ */
  .pack-wrap{ display:grid; grid-template-columns:0.9fr 1.1fr; gap:70px; align-items:center; margin-top:40px; }
  .mala{
    width:100%; aspect-ratio:4/5; background:var(--terracota);
    position:relative; border-radius:6px;
    display:flex; align-items:center; justify-content:center;
    box-shadow:var(--shadow);
  }
  .mala::before{ content:""; position:absolute; inset:18px; border:1px dashed rgba(255,253,249,0.35); border-radius:3px; }
  .mala .seal{ color:var(--areia-soft); width:118px; height:118px; }
  .mala .seal span{ font-size:17px; }
  .pack-steps .step{ display:flex; gap:18px; padding:18px 0; border-top:1px solid var(--line); }
  .pack-steps .step:last-child{ border-bottom:1px solid var(--line); }
  .pack-steps .num{ font-family:'Fraunces',serif; font-style:italic; color:var(--terracota-deep); font-size:20px; flex-shrink:0; width:34px; }
  .pack-steps b{ display:block; font-size:15.5px; margin-bottom:4px; }
  .pack-steps p{ font-size:13.5px; }
  @media (max-width:860px){ .pack-wrap{ grid-template-columns:1fr; } .mala{ max-width:280px; margin:0 auto; } }

  /* ============ launch timeline ============ */
  .timeline{ display:grid; grid-template-columns:repeat(4,1fr); gap:0; margin-top:56px; position:relative; }
  .timeline::before{ content:""; position:absolute; top:11px; left:0; right:0; height:1px;
    background-image: repeating-linear-gradient(90deg, var(--terracota-deep) 0 7px, transparent 7px 15px); }
  .tl-item{ padding-right:24px; }
  .tl-item .dot{ width:23px; height:23px; border-radius:50%; background:var(--areia-soft); border:1.5px solid var(--terracota-deep); display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; color:var(--terracota-deep); margin-bottom:20px; position:relative; z-index:2; }
  .tl-item h3{ font-size:16.5px; margin-bottom:10px; }
  .tl-item ul{ list-style:none; display:flex; flex-direction:column; gap:8px; }
  .tl-item li{ font-size:13px; color:var(--ink-soft); padding-left:14px; position:relative; }
  .tl-item li::before{ content:"—"; position:absolute; left:0; color:var(--terracota); }
  @media (max-width:860px){ .timeline{ grid-template-columns:1fr; gap:34px; } .timeline::before{ display:none; } }

  /* ============ architecture ============ */
  .arch-wrap{ display:flex; flex-direction:column; align-items:center; margin-top:56px; gap:0; }
  .arch-root{ background:var(--oliva); color:var(--cream); padding:20px 42px; font-family:'Fraunces',serif; font-size:20px; font-weight:500; }
  .arch-line{ width:1px; height:40px; background-image: repeating-linear-gradient(180deg, var(--oliva) 0 6px, transparent 6px 12px); }
  .arch-branches{ display:flex; gap:0; position:relative; width:100%; max-width:640px; justify-content:space-between; }
  .arch-branches::before{ content:""; position:absolute; top:-40px; left:25%; right:25%; height:1px; background:var(--oliva); }
  .arch-child{ border:1px solid var(--line); background:var(--cream); padding:22px 26px; width:47%; text-align:center; position:relative; }
