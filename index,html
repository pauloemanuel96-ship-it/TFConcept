    const isDark = sec.classList.contains('dark') || sec.id === 'manifesto';
    if (isDark) btn.classList.add('on-dark');
    btn.innerHTML = `<span class="lbl">${sec.dataset.label}</span><span class="dot"></span>`;
    btn.addEventListener('click', () => sec.scrollIntoView({behavior:'smooth'}));
    rail.appendChild(btn);
  });
  const railBtns = Array.from(rail.children);
  const counterEl = document.getElementById('curSlide');

  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const idx = sections.indexOf(entry.target);
      if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
        railBtns.forEach(b => b.classList.remove('active'));
        railBtns[idx].classList.add('active');
        counterEl.textContent = String(idx + 1).padStart(2, '0');
      }
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.reveal').forEach(el => el.classList.add('in'));
      }
    });
  }, { threshold: [0, 0.5] });

  sections.forEach(sec => io.observe(sec));

  // animate score bars once visible
  const scoreList = document.getElementById('scoreList');
  if (scoreList) {
    const scoreIO = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          scoreList.querySelectorAll('.score-row').forEach(row => {
            const pct = (row.dataset.score / 5) * 100;
            row.querySelector('.score-fill').style.width = pct + '%';
          });
          scoreIO.disconnect();
        }
      });
    }, { threshold: 0.3 });
    scoreIO.observe(scoreList);
  }
</script>

</body>
</html>
